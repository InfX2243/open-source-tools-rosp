# ====================================
# Root .gitignore for open-source-tools
# ====================================

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Packaging & distribution
build/
dist/
develop-eggs/
eggs/
.eggs/
*.egg-info/
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
*.cover
.cache

# Node / Frontend
node_modules/
.vite/
vite.config.*.timestamp-*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Databases & local run logs
*.db
*.sqlite
*.sqlite3
dataguard.db
datadiff_history.db

# Generated reports & artifact exports
report.html
report.sarif
diff_report.html
containersec-report.html
*.sarif

# Environments & VirtualEnvs
.env
.env.*
.venv/
env/
venv/
ENV/

# IDE & Editor folders
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
